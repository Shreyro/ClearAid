# ---- PayPal (sandbox) --------------------------------------------------------
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run ClearAid in DEMO MODE (PayPal calls are simulated locally).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# Webhook ID from the dashboard (Apps > your app > Webhooks). Needed to verify
# webhook signatures at /api/paypal/webhook.
PAYPAL_WEBHOOK_ID=
# ClearAid's PayPal partner (platform) app: lets NGOs connect PayPal accounts by
# logging in to PayPal ("Connect with PayPal" on Sources) instead of pasting keys.
# Client ID and secret: the platform app under Apps & Credentials. Merchant ID:
# the Account ID of the partner's own business account (Sandbox Accounts > the
# account > Account ID). Webhook: add one to the partner app pointing at
# <public address>/api/paypal/webhook?account=partner and put its ID here.
# PAYPAL_PARTNER_CLIENT_ID=
# PAYPAL_PARTNER_CLIENT_SECRET=
# PAYPAL_PARTNER_MERCHANT_ID=
# PAYPAL_PARTNER_WEBHOOK_ID=
# PAYPAL_PARTNER_BN_CODE=

# ---- Local AI (Ollama) ---------------------------------------------------------
# Every AI feature runs on this machine: the Copilot, PII redaction, receipt and
# photo audits, crisis insights and fund drafting all use COPILOT_MODEL (default
# llama3.1:8b, kept loaded between calls). Reading an image needs a model that
# can see: if COPILOT_MODEL can't, LOCAL_VISION_MODEL is used for that call only.
# Set LOCAL_AI=off to use the built-in non-AI fallbacks everywhere.
# RENDER_MODE=YES (the hosted deployment) switches every AI feature and the Copilot off. Unset or NO = AI on,
# which is what you want when you run the code on your own machine.
# RENDER_MODE=NO
# LOCAL_AI=off
# COPILOT_MODEL=llama3.1:8b
# LOCAL_VISION_MODEL=llava
# OLLAMA_URL=http://127.0.0.1:11434

# ---- Optional integrations ----------------------------------------------------
# Where the JSON store and uploads live. Docker/docker-compose override this
# with /data (a volume); attach a Render disk there in prod.
DATA_DIR=.data
# Port the API listens on (the frontend proxies /api/* here)
PORT=4000
# Public URL of the FRONTEND (used in PayPal return URLs and outbound webhooks)
APP_URL=http://localhost:3000

# ---- Plaid (bank connections) ------------------------------------------------
# Keys from https://dashboard.plaid.com/developers/keys. Leave blank to use the
# built-in simulated bank on the Bank accounts page instead.
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (default) or "production"
PLAID_ENV=sandbox
# Banks that log in on their own website (Chase, Wells Fargo…) send people back
# here; add the same URL under "Allowed redirect URIs" in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://your-app.example/oauth/plaid
# Plaid calls this when new transactions are ready (must be public HTTPS).
# PLAID_WEBHOOK_URL=https://your-api.example/api/plaid/webhook
# Countries whose banks are offered, comma-separated (default US).
# PLAID_COUNTRY_CODES=US
# History to fetch when a bank is connected, in days (default and max 730).
# PLAID_HISTORY_DAYS=730
# Also sync every connected bank this often, in minutes (default 60; 0 = off).
# PLAID_SYNC_MINUTES=60

# ---- Local Copilot (Llama via Ollama + FAISS) -----------------------------------
# Answering model in Ollama (run: ollama pull llama3.1:8b). Any Ollama chat model works.
COPILOT_MODEL=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
# The FAISS search service: python rag/server.py (env RAG_PORT, EMBED_MODEL, RAG_DATA)
RAG_URL=http://127.0.0.1:8790
# Optional shared secret; set the same value in the environment of rag/server.py
RAG_TOKEN=
# Hosting the AI on a Render service that sleeps when idle (set by render.yaml; leave empty locally):
# AI_HOST=clearaid-ai
# RENDER_API_KEY=
# RENDER_AI_SERVICE_ID=
# AI_IDLE_MINUTES=10
