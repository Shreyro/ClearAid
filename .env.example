# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# API keys (PayPal, Plaid, Anthropic) go in backend/.env, as for local development.

# Port the web UI is published on, and the public URL people use to reach it
# (PayPal return URLs and links in outbound webhooks).
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000

# Signs sign-in cookies and encrypts stored PayPal and bank keys. Set a long random
# value in production (e.g. `openssl rand -hex 32`) and keep it: changing it signs
# everyone out and makes saved keys unreadable. Empty: one is generated on first
# start and kept in the data volume.
SESSION_SECRET=

# Shared secret between the API and the rag service (both read it from here).
RAG_TOKEN=

# Local models served by the ollama container.
COPILOT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
OLLAMA_VERSION=0.40.16
