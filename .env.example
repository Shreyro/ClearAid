# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# API keys (PayPal, Plaid) go in backend/.env, as for local development. All AI runs locally in Ollama.

# Port the web UI is published on, and the public URL people use to reach it
# (PayPal return URLs and links in outbound webhooks).
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000
# With a public HTTPS address (scripts/prod-local.mjs sets these from the tunnel):
# PLAID_REDIRECT_URI=https://<public address>/oauth/plaid
# PLAID_WEBHOOK_URL=https://<public address>/api/plaid/webhook

# Signs sign-in cookies and encrypts stored PayPal and bank keys. Set a long random
# value in production (e.g. `openssl rand -hex 32`) and keep it: changing it signs
# everyone out and makes saved keys unreadable. Empty: one is generated on first
# start and kept in the data volume.
SESSION_SECRET=

# Shared secret between the API and the rag service (both read it from here).
RAG_TOKEN=

# Local models served by the ollama container.
# Which optional parts run: "ollama" (Ollama and its models in containers) and/or
# "tunnel" (a public HTTPS address). Without "ollama", set OLLAMA_URL to an
# Ollama on the host, e.g. http://host.docker.internal:11434 (Docker Desktop).
COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://host.docker.internal:11434
COPILOT_MODEL=llama3.1:8b
# Only for reading receipt and photo images (when COPILOT_MODEL can't see images).
LOCAL_VISION_MODEL=llava
EMBED_MODEL=nomic-embed-text
OLLAMA_VERSION=0.40.16
