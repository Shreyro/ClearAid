# ---- PayPal (sandbox) --------------------------------------------------------
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run ClearAid in DEMO MODE (PayPal calls are simulated locally).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# Webhook ID from the dashboard (Apps > your app > Webhooks). Needed to verify
# webhook signatures at /api/paypal/webhook.
PAYPAL_WEBHOOK_ID=

# ---- Anthropic (Claude) -------------------------------------------------------
# Powers PII redaction, receipt/photo audits, crisis insights, Ask ClearAid and
# the NGO Copilot. Leave blank to use the built-in heuristic fallbacks.
ANTHROPIC_API_KEY=
# Optional override (defaults to claude-opus-5-5)
CLAUDE_MODEL=

# ---- Optional integrations ----------------------------------------------------
# Every public ledger event is POSTed here as JSON (e.g. a Zapier "Catch Hook"),
# so donors/NGOs can fan out to Slack, SMS, email or Sheets with no code.
ZAPIER_WEBHOOK_URL=
# Where the JSON store and uploads live (attach a Render disk here in prod)
DATA_DIR=.data
# Public base URL (used in PayPal return URLs and outbound webhooks)
APP_URL=http://localhost:3000
